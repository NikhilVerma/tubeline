{
  "name": "@nikhilverma/tubeline",
  "version": "0.1.0",
  "description": "Draw any graph as an interactive tube map, with journey planning built in.",
  "keywords": [
    "graph",
    "graph-visualization",
    "tube-map",
    "metro-map",
    "transit-map",
    "workflow",
    "svg",
    "a-star",
    "typescript"
  ],
  "license": "MIT",
  "author": "Nikhil Verma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikhilVerma/tubeline.git"
  },
  "homepage": "https://nikhil-verma.com/tubeline/",
  "bugs": {
    "url": "https://github.com/NikhilVerma/tubeline/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "skills",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.16.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite demo",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "check:package": "publint && attw --pack . --profile esm-only",
    "release:check": "pnpm typecheck && pnpm test && pnpm test:e2e && pnpm check:package",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm release:check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
